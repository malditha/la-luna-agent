[Unit]
Description=La Luna Ops Monitoring Agent
Documentation=https://github.com/malditha/la-luna-agent
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
EnvironmentFile=/etc/la-luna-agent.env
ExecStart=/usr/bin/python3 /opt/la-luna-agent/la-luna-agent.py
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=la-luna-agent
StateDirectoryMode=0700
ReadWritePaths=/var/lib/la-luna-agent
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
[Install]
WantedBy=multi-user.target
