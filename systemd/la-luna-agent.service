[Unit]
Description=La Luna Ops Monitoring Agent
Documentation=https://github.com/malditha/la-luna-agent
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
EnvironmentFile=/etc/la-luna-agent.env
ExecStart=/usr/bin/python3 /opt/la-luna-agent/la-luna-agent.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/la-luna-agent
[Install]
WantedBy=multi-user.target
